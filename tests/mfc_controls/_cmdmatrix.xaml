<?xml version="1.0" encoding="utf-8"?>
<Window xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="cmd matrix" Width="480" Height="500">
  <StackPanel Orientation="Vertical" Spacing="6">
    <QCanvas x:Name="c1" Width="220" Height="110" Commands="Clear #232A33; Grad 10,10,200,80,#00A8E8,#7A5AF8,0" />
    <QCanvas x:Name="c2" Width="220" Height="110" Commands="Clear #232A33; GradRR 10,10,200,80,14,#57C84D,#0E8A6A,90" />
    <QCanvas x:Name="c3" Width="220" Height="110" Commands="Clear #232A33; Fill 20,20,100,20,60,90,#E8A030" />
    <QCanvas x:Name="c4" Width="220" Height="110" Commands="Clear #232A33; Path 20,20,60,60,100,20,140,80,#FFFFFF,3" />
    <QCanvas x:Name="c5" Width="220" Height="110" Commands="Clear #232A33; Shadow 20,20,120,60,12,#000000,150,6,10,12" />
    <QCanvas x:Name="c6" Width="220" Height="110" Commands="Clear #232A33; Alpha 140; Rect 20,20,120,60,#00A8E8; AlphaEnd; Text 20,90,半透明字,10,#FFFFFF" />
    <QCanvas x:Name="c7" Width="220" Height="110" Commands="Clear #232A33; Rot 18,110,55; Rect 60,35,100,40,#FF5C7A; RotEnd" />
  </StackPanel>
</Window>
