<?xml version="1.0" encoding="utf-8"?>
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基础控件测试" Width="560" Height="820">
  <XStackPanel Margin="14" Spacing="8">

    <XLabel x:Name="lblHead" Text="基础控件（Button / TextBlock / TextBox / CheckBox / RadioButton / GroupBox / ComboBox / ListBox / ProgressBar / Slider）"
               Height="40"/>

    <XTextField x:Name="txtInput" Text="初始文本" Height="30"/>
    <XButton x:Name="btnOk" Text="确定" Height="32"/>
    <XCheckBox x:Name="chkAgree" Text="同意条款" Height="26"/>
    <XRadioButton x:Name="radA" Text="选项 A" Height="26"/>
    <XRadioButton x:Name="radB" Text="选项 B" Height="26"/>
    <XGroupBox x:Name="grpTest" Header="分组框" Height="70"/>
    <XComboBox x:Name="cmbCity" Height="30"/>
    <XListBox x:Name="lstItems" Height="120"/>
    <XProgressBar x:Name="prgWork" Height="22"/>
    <XSlider x:Name="sldLevel" Height="32"/>
    <XLabel x:Name="lblStatus" Text="就绪" Height="26"/>
    <XButton x:Name="btnHidden" Text="隐藏测试" Height="30"/>

  </XStackPanel>
</XWindow>
