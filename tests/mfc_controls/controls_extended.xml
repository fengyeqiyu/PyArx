<?xml version="1.0" encoding="utf-8"?>
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="扩展控件测试" Width="640" Height="900">
  <XStackPanel Margin="14" Spacing="8">

    <XLabel x:Name="lblHead" Text="扩展控件（Tab / Tree / ListCtrl / Choice / DatePicker / Panel / Splitter / StaticLine / Hyperlink / RichText / Toggle / BitmapButton / StaticBitmap / GridCtrl / ScrolledWindow / Calendar）"
               Height="40"/>

    <XTabBar x:Name="tabMain" Height="130"/>
    <XTreeView x:Name="treeFiles" Height="120"/>
    <XListCtrl x:Name="lstView" Height="110"/>
    <XChoice x:Name="choPick" Height="30"/>
    <XDatePicker x:Name="dtpDate" Height="30"/>
    <XPane x:Name="pnlHost" Height="60"/>
    <XSplitView x:Name="splVert" Height="18"/>
    <XDivider x:Name="lnSep" Height="10"/>
    <XHyperlink x:Name="lnkOpen" Text="打开示例链接" Height="26"/>
    <XTextArea x:Name="rtfNote" Height="90"/>
    <XToggleButton x:Name="tglMode" Text="切换模式" Height="30"/>
    <XIconButton x:Name="bbtnRun" Text="运行" Height="32"/>
    <XImage x:Name="sbmpPreview" Height="50"/>
    <XGridLayout x:Name="grdData" Height="110"/>
    <XScrollView x:Name="scrArea" Height="80"/>
    <XMonthGrid x:Name="calPick" Height="150"/>

  </XStackPanel>
</XWindow>
