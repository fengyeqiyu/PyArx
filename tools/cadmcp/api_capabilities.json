 "known_absent": [
  {
   "name": "PyDbEntity.getBoundingPoints",
   "why": "61 个方法里不存在；包围盒用 bounds() -> (min,max) 或 getGeomExtents()"
  },
  {
   "name": "PyDbEntity.openObjectByIdString",
   "why": "不存在；按句柄读实物只能事务内 tr.openObject(eid,0) 遍历比对 handle()"
  },
  {
   "name": "PyDbEntity.isA",
   "why": "实体上没有 isA；类名用 className()"
  },
  {
   "name": "Ge.AcGePoint3dArray",
   "why": "Ge 子模块未导出该数组类型；样条改用 setFitPointAt/insertFitPointAt"
  },
  {
   "name": "PyDbWipeout.appendLoopPoints",
   "why": "11 个方法里只有 append；且按 list 传参仍 addEntity=False，遮挡图元构造未打通"
  },
  {
   "name": "PyDbMline.appendSegments",
   "why": "真名是 appendSeg（单词，不是复数）；但只 appendSeg 后 bounds 为空盒"
  },
  {
   "name": "PyDbPoint(点)",
   "why": "无带点构造；PyDbPoint() + setPosition(pt)"
  },
  {
   "name": "PyDbSolid(四点)",
   "why": "无四参构造；PyDbSolid() + setPointAt(i, pt) 四次"
  },
  {
   "name": "PyDbXline/Ray(点+方向)",
   "why": "无带参构造；() + setBasePoint + setUnitDir(AcGeVector3d)"
  },
  {
   "name": "PyDbEllipse.setMajorAxis",
   "why": "不存在；用 setCenter/setMajorRadius/setRadiusRatio"
  },
  {
   "name": "PyDbEllipse 半径 setter",
   "why": "入库前后各试一次，setMajorRadius/setRadiusRatio 均不生效，bounds 恒为默认单位圆 ±1 —— 疑绑定层 setter 缺陷，需查 C++ 侧 PyDbEllipse 的属性桥接"
  }
 ],
 "pitfalls": [
  "开对象必须显式给模式：tr.openObject(eid, 0)=kForRead / 1=kForWrite，不许省略",
  "图元/表/符号表默认写模式；纯查询传读模式",
  "符号表在一个进程里只能开一次且必须 close()，否则带写锁存盘会崩",
  "addEntity 返回 bool，失败不抛异常——必须判返回值",
  "新建实体先 addEntity 入模型空间再写属性（入库前未 setDatabaseDefaults）",
  "图层要在事务外建：getLayerTable -> newRecord -> setName/setColor -> lt.add"
 ],
