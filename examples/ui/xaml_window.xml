<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 XAML 写法：标签名 = 控件类型，属性用 XAML 名，控件用 x:Name 命名。
     注意：x: 前缀必须像下面这样声明，否则 XML 解析器会报 unbound prefix。 -->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAML 界面演示" Width="460" Height="640" Theme="dark">

    <XStackPanel>
        <XTextBlock x:Name="hint" Content="下面的按钮由 Click 绑定"/>
        <XButton x:Name="btnDraw" Content="点我" Width="160" Height="34" Click="OnDraw"/>
        <XTextBox x:Name="txtRadius" Content="R=100" Height="28" TextChanged="OnRadiusChanged"/>
    </XStackPanel>

    <XGroupBox x:Name="grpOptions" Header="选项" Height="250">
        <XCheckBox x:Name="chkEnable" Content="启用选项" IsChecked="1" Height="24"/>
        <XComboBox x:Name="cmbSize" Items="小|中|大" Height="120"/>
        <XSlider x:Name="sldValue" Minimum="0" Maximum="100" Value="30" Height="32"/>
    </XGroupBox>

    <XStackPanel Orientation="Horizontal" Height="40">
        <XButton x:Name="btnLeft" Content="左" Width="90" Height="32"/>
        <XButton x:Name="btnRight" Content="右" Width="90" Height="32"/>
    </XStackPanel>

    <XListBox x:Name="lstItems" Items="alpha|beta|gamma" Height="90" SelectionChanged="OnListChanged"/>
    <XProgressBar x:Name="prgLoad" Minimum="0" Maximum="100" Value="40" Height="20"/>
</XWindow>
