                ForeColor="#FF9AA4AE" FontSize="10" TextAlign="Left" BorderStyle="None"/>
        <XLabel Name="pr1v" Text="—" Width="228" Height="24" Background="#FF2B3036"
                ForeColor="#FFE6EDF3" FontSize="10" TextAlign="Right"/>
      </XStackPanel>
      <XStackPanel Name="prow2" Orientation="Horizontal" Width="348" Height="24"
