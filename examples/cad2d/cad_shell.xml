              Background="#FF2B3036" ForeColor="#FFE6EDF3" FontSize="11"
              FontWeight="Bold" TextAlign="Left"/>
      <XTableView Name="tblLayers" Width="348" Height="110"
                  Columns="名称&#9;颜色&#9;线宽&#9;显示&#9;锁定"
