         不再出现系统标题栏，也不会和下面的暗色外壳撞色。 -->
    <MenuBar Grid.Row="0" Background="#252A33" Foreground="#E8EDF4" MutedColor="#9AA7B8"
           BorderColor="#39404B" AccentColor="#4C8DFF"
           FontSize="10" TitleWidth="120" WinButtonWidth="46" ItemGap="10">

      <XImage Name="appLogo" Source="res\logo.png" Width="32" Height="32"/>
      <ShellTitle Name="winTitle" Text="PyArx"/>

      <MenuItem Name="mnuFile" Header="文件">
        <MenuItem Name="mnuNew"     Header="新建"/>
        <MenuItem Name="mnuOpen"    Header="打开 XML…"/>
        <MenuItem Name="mnuSave"    Header="保存"/>
        <MenuItem Name="mnuSaveAs"  Header="另存为…"/>
        <MenuItem Name="mnuExit"    Header="退出"/>
      </MenuItem>

      <MenuItem Name="mnuEdit" Header="编辑">
        <MenuItem Name="mnuUndo"    Header="撤销"/>
        <MenuItem Name="mnuRedo"    Header="重做"/>
        <MenuItem Name="mnuCut"     Header="剪切"/>
        <MenuItem Name="mnuCopy"    Header="复制"/>
        <MenuItem Name="mnuPaste"   Header="粘贴"/>
        <MenuItem Name="mnuDelete"  Header="删除"/>
      </MenuItem>

      <MenuItem Name="mnuView" Header="视图">
        <MenuItem Name="mnuGrid"    Header="网格线"/>
        <MenuItem Name="mnuRuler"   Header="标尺"/>
        <MenuItem Name="mnuZoomIn"  Header="放大"/>
        <MenuItem Name="mnuZoomOut" Header="缩小"/>
        <MenuItem Name="mnuZoomFit" Header="适应窗口"/>
      </MenuItem>

      <MenuItem Name="mnuFormat" Header="格式">
        <MenuItem Name="mnuAlignLeft"    Header="左对齐"/>
        <MenuItem Name="mnuAlignHCenter" Header="水平居中"/>
        <MenuItem Name="mnuAlignRight"   Header="右对齐"/>
        <MenuItem Name="mnuAlignTop"     Header="顶对齐"/>
        <MenuItem Name="mnuAlignVCenter" Header="垂直居中"/>
        <MenuItem Name="mnuAlignBottom"  Header="底对齐"/>
        <XDivider/>
        <MenuItem Name="mnuDistH"        Header="横向均匀分布"/>
        <MenuItem Name="mnuDistV"        Header="纵向均匀分布"/>
      </MenuItem>

      <MenuItem Name="mnuHelp" Header="帮助">
        <MenuItem Name="mnuPreview" Header="在预览器中打开"/>
        <MenuItem Name="mnuCheck"   Header="校验当前 XML"/>
        <MenuItem Name="mnuAbout"   Header="关于 PyArx"/>
      </MenuItem>

      <!-- 窗口按钮：Dock 靠右，颜色/字形由 paintMenuBar 自绘 -->
      <XButton Name="btnWinClose" Role="WinClose" Dock="Right" Width="46" Height="32"/>
      <XButton Name="btnWinMax"   Role="WinBtn"   Dock="Right" Width="46" Height="32"/>
      <XButton Name="btnWinMin"   Role="WinBtn"   Dock="Right" Width="46" Height="32"/>

    </MenuBar>

    <!-- ==================== 选项卡条（Ribbon：文件 / 开始 / 插入 …） ==================== -->
    <ToolBar Grid.Row="1" Background="#232830" Foreground="#C8D2DF" FontSize="10"
             BorderColor="#39404B" Spacing="0" Padding="10,0,10,0">
      <XButton Name="tabFile" Role="Tab" Text="文件" Width="66" Height="32"/>
      <XButton Name="tabHome" Role="Tab" Text="开始" Width="66" Height="32" Selected="1"/>
      <XButton Name="tabInsert" Role="Tab" Text="插入" Width="66" Height="32"/>
      <XButton Name="tabLayout" Role="Tab" Text="布局" Width="66" Height="32"/>
      <XButton Name="tabView" Role="Tab" Text="视图" Width="66" Height="32"/>
      <XButton Name="tabHelp" Role="Tab" Text="帮助" Width="66" Height="32"/>
      <XButton Name="btnCheck" Text="校验" Role="Ghost" Dock="Right" Width="68" Height="26" Margin="0,3,10,0" FontSize="10"/>
      <XButton Name="btnPreview" Text="预览" Role="Primary" Dock="Right" Width="80" Height="26" Margin="0,3,16,0" FontSize="10"/>
    </ToolBar>

    <!-- ==================== Ribbon 功能区（分组 + 大图标按钮 + 组名） ====================
         结构全部写在 XML：组的位置/宽度由 Left/Width 决定，组名是 Role="GroupTitle" 的 XLabel，
         按钮图标与标题来自 Icon/Text。要增删组只改这里，C++ 不需要动。 -->
    <ToolBar Grid.Row="2" Background="#20242C" Foreground="#E4E9F0" BorderColor="#39404B" Height="92">
      <XButton Name="btnNew" Icon="res/new.png" Text="新建" Left="12" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnOpen" Icon="res/open.png" Text="打开" Left="70" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnSave" Icon="res/save.png" Text="保存" Left="128" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupQuickAccess" Role="GroupTitle" Text="快速访问" Left="12" Top="68" Width="174" Height="16" FontSize="9"/>
      <XDivider Left="191" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnPaste" Icon="res/paste.png" Text="粘贴" Left="199" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnCut" Icon="res/cut.png" Text="剪切" Left="257" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnCopy" Icon="res/copy.png" Text="复制" Left="315" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnDelete" Icon="res/del.png" Text="删除" Left="373" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupClip" Role="GroupTitle" Text="剪贴板" Left="199" Top="68" Width="232" Height="16" FontSize="9"/>
      <XDivider Left="436" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnUndo" Icon="res/undo.png" Text="撤销" Left="444" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnRedo" Icon="res/redo.png" Text="重做" Left="502" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupEdit" Role="GroupTitle" Text="编辑" Left="444" Top="68" Width="116" Height="16" FontSize="9"/>
      <XDivider Left="565" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnAlignLeft" Icon="res/alignleft.png" Text="左" Left="573" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnAlignHCenter" Icon="res/alignhcenter.png" Text="居中" Left="631" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnAlignRight" Icon="res/alignright.png" Text="右" Left="689" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnAlignTop" Icon="res/aligntop.png" Text="上" Left="747" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnAlignVCenter" Icon="res/alignvcenter.png" Text="居中" Left="805" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnAlignBottom" Icon="res/alignbottom.png" Text="下" Left="863" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupAlign" Role="GroupTitle" Text="对齐" Left="573" Top="68" Width="348" Height="16" FontSize="9"/>
      <XDivider Left="926" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnDistH" Icon="res/disth.png" Text="横分布" Left="934" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnDistV" Icon="res/distv.png" Text="纵分布" Left="992" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupDist" Role="GroupTitle" Text="分布" Left="934" Top="68" Width="116" Height="16" FontSize="9"/>
      <XDivider Left="1055" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnGrid" Icon="res/grid.png" Text="网格" Left="1063" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnRuler" Icon="res/ruler.png" Text="标尺" Left="1121" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupView" Role="GroupTitle" Text="视图" Left="1063" Top="68" Width="116" Height="16" FontSize="9"/>
      <XDivider Left="1184" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
      <XButton Name="btnZoomOut" Icon="res/zoomout.png" Text="缩小" Left="1192" Top="4" Width="58" Height="60" FontSize="9"/>
      <XButton Name="btnZoomIn" Icon="res/zoomin.png" Text="放大" Left="1250" Top="4" Width="58" Height="60" FontSize="9"/>
      <XLabel Name="lblGroupZoom" Role="GroupTitle" Text="缩放" Left="1192" Top="68" Width="116" Height="16" FontSize="9"/>
      <XDivider Left="1313" Top="8" Width="1" Height="64" Thickness="1" Orientation="Vertical" Background="#39404B"/>
    </ToolBar>

    <!-- ==================== 主体三栏 ==================== -->
    <XGrid Grid.Row="3" Background="#15181D">
      <XGrid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>   <!-- 控件箱 -->
        <ColumnDefinition Width="5"/>     <!-- 垂直 Splitter -->
        <ColumnDefinition Width="*"/>     <!-- 画布 -->
        <ColumnDefinition Width="5"/>     <!-- 垂直 Splitter -->
        <ColumnDefinition Width="320"/>   <!-- 对象检查器 + 属性编辑器 -->
      </XGrid.ColumnDefinitions>

      <!-- ========== 左栏：控件箱 ========== -->
      <XGrid Grid.Column="0" Background="#1C2027">
        <XGrid.RowDefinitions>
          <RowDefinition Height="32"/>    <!-- 标题条 -->
          <RowDefinition Height="34"/>    <!-- 分类过滤 -->
          <RowDefinition Height="*"/>     <!-- 控件箱树 -->
        </XGrid.RowDefinitions>

        <XPanelHeader Name="hdrWidgetBox" Grid.Row="0" Text="控件箱" Count="69 个控件"/>

        <XChipBar Name="widgetChips" Grid.Row="1" Background="#1C2027" Foreground="#C7D0DC"
            BorderColor="#39404B" AccentColor="#4C8DFF"
            FontSize="10" PaddingLeft="8" ItemGap="7" Padding="8,7,6,0">
          <Chip Name="chipAll"    Text="全部" Category=""                 Checked="True" Width="42" Height="22"/>
          <Chip Name="chipLayout" Text="容器" Category="Containers"       Width="42" Height="22"/>
          <Chip Name="chipButton" Text="按钮" Category="Buttons"          Width="42" Height="22"/>
          <Chip Name="chipInput"  Text="输入" Category="Input Widgets"    Width="42" Height="22"/>
          <Chip Name="chipShow"   Text="显示" Category="Display Widgets"  Width="42" Height="22"/>
        </XChipBar>

        <XTreeView Name="widgetBox" Grid.Row="2" FontSize="9" LineHeight="22"
                    Background="#1C2027" Foreground="#E4E9F0" SelectionColor="#2A4A7A">
          <TreeRow Text="Draw" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="直线" Level="1"/>
          <TreeRow Text="矩形" Level="1"/>
          <TreeRow Text="圆" Level="1"/>
          <TreeRow Text="圆弧" Level="1"/>
          <TreeRow Text="Buttons" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="Button" Level="1"/>
          <TreeRow Text="CheckBox" Level="1"/>
          <TreeRow Text="RadioButton" Level="1"/>
          <TreeRow Text="ToggleButton" Level="1"/>
          <TreeRow Text="IconButton" Level="1"/>
          <TreeRow Text="RoundButton" Level="1"/>
          <TreeRow Text="DelayButton" Level="1"/>
          <TreeRow Text="ToolButton" Level="1"/>
          <TreeRow Text="Canvas" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="PowerCanvas" Level="1"/>
          <TreeRow Text="QCanvas" Level="1"/>
          <TreeRow Text="Containers" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="GroupBox" Level="1"/>
          <TreeRow Text="TabBar" Level="1"/>
          <TreeRow Text="Border" Level="1"/>
          <TreeRow Text="Pane" Level="1"/>
          <TreeRow Text="SplitView" Level="1"/>
          <TreeRow Text="TreeView" Level="1"/>
          <TreeRow Text="ListCtrl" Level="1"/>
          <TreeRow Text="Divider" Level="1"/>
          <TreeRow Text="GridLayout" Level="1"/>
          <TreeRow Text="ScrollView" Level="1"/>
          <TreeRow Text="Flickable" Level="1"/>
          <TreeRow Text="Frame" Level="1"/>
          <TreeRow Text="TabButton" Level="1"/>
          <TreeRow Text="Data Views" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="PageIndicator" Level="1"/>
          <TreeRow Text="TableView" Level="1"/>
          <TreeRow Text="TreeTable" Level="1"/>
          <TreeRow Text="VirtualList" Level="1"/>
          <TreeRow Text="StackView" Level="1"/>
          <TreeRow Text="SwipeView" Level="1"/>
          <TreeRow Text="GridView" Level="1"/>
          <TreeRow Text="PathView" Level="1"/>
          <TreeRow Text="Page" Level="1"/>
          <TreeRow Text="Display Widgets" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="Label" Level="1"/>
          <TreeRow Text="ProgressBar" Level="1"/>
          <TreeRow Text="Hyperlink" Level="1"/>
          <TreeRow Text="TextArea" Level="1"/>
          <TreeRow Text="Image" Level="1"/>
          <TreeRow Text="MonthGrid" Level="1"/>
          <TreeRow Text="BusyIndicator" Level="1"/>
          <TreeRow Text="ScrollIndicator" Level="1"/>
          <TreeRow Text="Draw" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="Line" Level="1"/>
          <TreeRow Text="Rectangle" Level="1"/>
          <TreeRow Text="Ellipse" Level="1"/>
          <TreeRow Text="Arc" Level="1"/>
          <TreeRow Text="Function Bar" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="ToolBar" Level="1"/>
          <TreeRow Text="MenuBar" Level="1"/>
          <TreeRow Text="ToolSeparator" Level="1"/>
          <TreeRow Text="Input Widgets" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="TextField" Level="1"/>
          <TreeRow Text="ComboBox" Level="1"/>
          <TreeRow Text="ListBox" Level="1"/>
          <TreeRow Text="Choice" Level="1"/>
          <TreeRow Text="DatePicker" Level="1"/>
          <TreeRow Text="CodeEditor" Level="1"/>
          <TreeRow Text="Slider" Level="1"/>
          <TreeRow Text="Switch" Level="1"/>
          <TreeRow Text="SpinBox" Level="1"/>
          <TreeRow Text="RangeSlider" Level="1"/>
          <TreeRow Text="Dial" Level="1"/>
          <TreeRow Text="Tumbler" Level="1"/>
          <TreeRow Text="ScrollBar" Level="1"/>
          <TreeRow Text="Item Views" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="ItemView" Level="1"/>
          <TreeRow Text="Overlay" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="ToolTip" Level="1"/>
          <TreeRow Text="Menu" Level="1"/>
          <TreeRow Text="Popup" Level="1"/>
          <TreeRow Text="Dialog" Level="1"/>
          <TreeRow Text="Drawer" Level="1"/>
          <TreeRow Text="MenuItem" Level="1"/>
          <TreeRow Text="ShellTitle" Level="1"/>
          <TreeRow Text="MenuSeparator" Level="1"/>
        </XTreeView>
      </XGrid>

      <XSplitView Grid.Row="2" Grid.Column="1"/>

      <!-- ========== Draw 竖条（左侧工具栏，外观由本 XML 决定） ========== -->

      <!-- ========== 中间：文档标签条 + 画布舞台 ========== -->
      <XGrid Grid.Column="2" Background="#15181D">
        <XGrid.RowDefinitions>
          <RowDefinition Height="36"/>
          <RowDefinition Height="*"/>
        </XGrid.RowDefinitions>

        <XTabStrip Name="docTabs" Grid.Row="0" Background="#20242C" Foreground="#E4E9F0"
            BorderColor="#39404B" AccentColor="#4C8DFF" FontSize="10"
            Orientation="Horizontal" Padding="8,6,0,0" Spacing="6">
          <Tab Name="tabDoc" Text="designer_layout.xml" Active="True" Width="300" Height="28"/>
        </XTabStrip>

        <XStage Grid.Row="1" Background="#0E1013" BorderColor="#2A2F38" GridSize="24" GridColor="#22262E">
          <XGrid Margin="14,12,14,14">
            <XCanvas Name="canvasHost" Background="#FFFFFF"/>
          </XGrid>
        </XStage>
      </XGrid>

      <XSplitView Grid.Row="2" Grid.Column="3"/>

      <!-- ========== 右栏：对象检查器 + 属性编辑器 ========== -->
      <XGrid Grid.Column="4" Background="#1C2027">
        <XGrid.RowDefinitions>
          <RowDefinition Height="32"/>    <!-- 对象检查器标题 -->
          <RowDefinition Height="*"/>     <!-- 对象树（与属性表均分右栏高度） -->
          <RowDefinition Height="6"/>     <!-- 水平 Splitter -->
          <RowDefinition Height="32"/>    <!-- 属性编辑器标题 -->
          <RowDefinition Height="*"/>     <!-- 属性表 -->
        </XGrid.RowDefinitions>

        <XPanelHeader Name="hdrInspector" Grid.Row="0" Text="对象检查器" Count="123 节点" FontSize="10"/>
        <XTreeView Name="objInspector" Grid.Row="1" FontSize="9" LineHeight="22"
                      Background="#1C2027" Foreground="#E4E9F0" SelectionColor="#2A4A7A">
          <TreeRow Text="XWindow (unnamed)" Level="0" HasChildren="True" Expanded="True"/>
          <TreeRow Text="XGrid rootGrid"    Level="1" HasChildren="True" Expanded="True"/>
          <TreeRow Text="XButton btnOpen"   Level="2"/>
          <TreeRow Text="XButton btnSave"   Level="2"/>
        </XTreeView>
        <XSplitView Grid.Row="2"/>
        <XPanelHeader Name="hdrProps" Grid.Row="3" Text="属性编辑器" Count="btnOpen" FontSize="10"/>
        <PropertyGrid Name="propsHost" Grid.Row="4" FontSize="9" Background="#1C2027" Foreground="#E4E9F0">
          <PropRow Name="通用"/>
          <PropRow Name="Name"      Value="btnOpen"/>
          <PropRow Name="Title"     Value="打开"/>
          <PropRow Name="Text"      Value="打开"/>
          <PropRow Name="Enabled"   Value="True"/>
          <PropRow Name="Visible"   Value="True"/>
          <PropRow Name="布局"/>
          <PropRow Name="Left"      Value="12"/>
          <PropRow Name="Top"       Value="8"/>
          <PropRow Name="Width"     Value="46"/>
          <PropRow Name="Height"    Value="48"/>
          <PropRow Name="Margin"    Value="2,0,2,0"/>
          <PropRow Name="属性"/>
          <PropRow Name="Background" Value="#2E3A44"/>
          <PropRow Name="Foreground" Value="#E4E9F0"/>
          <PropRow Name="BorderColor" Value="#39404B"/>
          <PropRow Name="FontSize"   Value="10"/>
          <PropRow Name="Icon"       Value="res/open.png"/>
        </PropertyGrid>
      </XGrid>
    </XGrid>

    <!-- 主体与代码坞之间的水平分隔条（上下拖动改变代码坞高度） -->
    <XSplitView Grid.Row="4"/>

    <!-- ==================== XML 源码坞 ==================== -->
    <XGrid Name="codeDock" Grid.Row="5" Background="#14171C">
      <XGrid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
      </XGrid.RowDefinitions>

      <XPanelHeader Name="hdrCode" Grid.Row="0" Text="XML 源码" Count="491 行 · UTF-8"/>

      <XCanvas Name="xmlCodeHost" Grid.Row="1" Background="#12151A"/>
    </XGrid>

    <!-- ==================== 状态栏 ==================== -->
    <StatusBar Grid.Row="6" Background="#252A33" Foreground="#C7D0DC"
             BorderColor="#39404B" FontSize="9" Spacing="0">
      <XLabel Name="statusBrand" Text="PyArx" Width="64"/>
      <XLabel Name="statusText"  Text="就绪"        Width="620"/>
      <XLabel Name="statusPos"   Text="X:0 Y:0"     Width="112"/>
      <XLabel Name="statusSize"  Text="W:0 H:0"     Width="112"/>
      <XLabel Name="statusZoom"  Text="100%"        Width="72"/>
    </StatusBar>

  </XGrid>
</XWindow>
