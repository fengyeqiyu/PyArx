<?xml version="1.0" encoding="utf-8"?>
<!--
  PyMfc UI Designer 主界面

  结构：单 Grid 五行 == 菜单栏 / 工具栏 / 主体三栏 / XML 代码坞 / 状态栏

  这一版是"设计器自身的深化设计"，整体走深色 IDE 外壳：
    · 工具栏按功能分组，按钮为"图标 + 标题"，右端是预览/校验的胶囊动作按钮
    · 左栏 = 标题条 + 分类过滤胶囊 + 控件箱树
    · 中间 = 文档标签条 + 画布舞台（Stage 台面 + 白纸画布）
    · 右栏 = 对象检查器 + 属性编辑器（标题条右侧实时显示节点数/选中标签）
    · 底部 = XML 源码坞（行号 + 语法着色），框选后右键复制 / Ctrl+C 取文本
    · 状态栏 = 品牌格 + 就绪信息 + 坐标 + 尺寸 + 缩放

  以下 Name 被 DesignerPaneView.cpp 按名字查找，改名会导致画布不出图、树不建、状态栏不更新：
    canvasHost / xmlCodeHost / widgetBox / objInspector / propsHost
    statusText / statusPos / statusSize / statusZoom
  另外 hdrWidgetBox / hdrInspector / hdrProps / hdrCode / tabDoc
  被绘制分支用来填动态提示，改名会退化成静态文案（不会崩，但会失去信息）。

  本仓库的自研 XML 语义（与 WPF 的差异，务必按这里写）：
    · 单趟布局，不做 measure/arrange；要一行拉伸必须显式 Height="*"
    · 容器只有 StackPanel / Grid / DockPanel / WrapPanel / Canvas / PaletteSet / Page
    · Canvas 是流式容器（不是绝对定位画布）；Dock 在任何容器里都生效
    · 未知标签不报错，按透明容器递归渲染；未登记属性静默放行（不校验拼写）
    · 没有 {Binding} / 属性元素语法 / DataTemplate

  本文新增的结构标签（设计器外壳构件，三端共用同一批绘制函数）：
    PanelHeader  Text=标题 Hint=右侧提示，子元素常为 Dock="Right" 的小按钮
    TabStrip     文档标签条；Tab Active="True" 表示当前文档
    ChipBar      分类过滤条；Chip Category="分类名" 空=全部
    Stage        画布舞台（深色台面 + 四角定位标）
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="PyArx"
        Width="1440"
        Height="900"
        Background="#15181D">

  <XGrid Name="rootGrid" Background="#15181D">
    <XGrid.RowDefinitions>
      <RowDefinition Height="38"/>     <!-- 标题 + 菜单栏（单表面自绘，窗体无边框） -->
      <RowDefinition Height="34"/>     <!-- 选项卡条（Ribbon 的 文件/开始/插入…） -->
      <RowDefinition Height="92"/>     <!-- Ribbon 功能区（分组 + 大图标按钮 + 组名） -->
      <RowDefinition Height="*"/>      <!-- 主体三栏 -->
      <RowDefinition Height="5"/>      <!-- 水平 Splitter（拖动调整代码坞高度） -->
      <RowDefinition Height="196"/>    <!-- XML 源码坞 -->
      <RowDefinition Height="28"/>     <!-- 状态栏 -->
    </XGrid.RowDefinitions>

    <!-- ==================== 标题栏 / 菜单栏（同一行） ==================== -->
