<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 12：Layout.alignment（QML RowLayout / ColumnLayout 的对齐）

  QML 写法：
      Button { Layout.alignment: Qt.AlignRight }
      Button { Layout.alignment: Qt.AlignHCenter }
      Label  { Layout.alignment: Qt.AlignFill }
  垂直流看水平分量（左/右/居中/填满），水平流看垂直分量（上/下/居中/填满）。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="12 对齐" Width="520" Height="300" Background="#F4F6F8">

  <XPane x:Name="Host" Padding="12">
    <XButton x:Name="A" text="默认靠左" width="120" height="32"/>
    <XButton x:Name="B" text="AlignRight" width="120" height="32"
             Layout.alignment="Qt.AlignRight"/>
    <XButton x:Name="C" text="AlignHCenter" width="120" height="32"
             Layout.alignment="Qt.AlignHCenter"/>
    <XLabel x:Name="D" text="AlignFill：宽度撑满可用区" height="28"
            Layout.alignment="Qt.AlignFill"/>
  </XPane>
</XWindow>
