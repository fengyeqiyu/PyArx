<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 08：CSS 定位（原 QML anchors 写法的等价版）

  QML 的 anchors.left/right/top/bottom/centerIn/fill 已删除，对应 CSS 写法：
      左上角 / 右上角 / 底部贴边   -> flex 行 + Justify（between / end）
      容器内居中                   -> flex 行 + Align/Justify = center
      四边内缩 40（inset:40）      -> 外层容器 Padding="40"，内层 Grow="1"
  注意：XML 里单写 Right/Bottom 属于右下锚定语义，撑满父请用 Width/Height=100%。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="08 CSS 定位" Width="520" Height="360" Background="#F4F6F8">

  <XPane x:Name="Host">
    <XStackPanel Display="flex" Flex="column" Gap="0" width="100%" height="100%">

      <XStackPanel Display="flex" Flex="row" Justify="between" Height="28">
        <XLabel x:Name="TL" text="左上角" width="120" height="28"/>
        <XLabel x:Name="TR" text="右上角" width="120" height="28"/>
      </XStackPanel>

      <XStackPanel Display="flex" Flex="row" Grow="1">
        <XPanel x:Name="InsetBox" Display="flex" Flex="row" Align="center" Justify="center"
                Padding="40" Grow="1">
          <XLabel x:Name="Center" text="居中 + 四边内缩 40" width="200" height="32"/>
        </XPanel>
      </XStackPanel>

      <XLabel x:Name="BottomBar" text="底部贴边" height="28"/>

    </XStackPanel>
  </XPane>
</XWindow>