<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 02：数据面板（表格 / 树 / 列表 / 分页）

  列用「名称:宽度」、行用制表符分隔，与 TableView 的口径一致。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="02 数据面板" Width="720" Height="700" Background="#F4F6F8">

  <XStackPanel Margin="16" Spacing="10">

    <XLabel x:Name="Hdr1" Text="台账" Height="26" FontSize="14" FontWeight="Bold"/>
    <XTableView x:Name="Ledger" Columns="回路:110|负载:80|状态:70|敷设:110"
               Rows="WL-AT1-1	11kW	正常	桥架
WL-AT1-2	30kW	警告	穿管
WL-AT2-1	8kW	正常	桥架"
               SelectedIndex="0" Height="130" SelectionChanged="on_row"/>

    <XLabel x:Name="Hdr2" Text="结构" Height="26" FontSize="14" FontWeight="Bold"/>
    <XTreeTable x:Name="Hier" Nodes="项目根>图纸 A|项目根>图层组>墙体" SelectedIndex="1" Height="110"/>
    <XTreeView x:Name="Tree1" Nodes="项目根>图纸 A|项目根>图纸 B" Height="100"/>
    <XListCtrl x:Name="Files" Columns="名称:150|类型:90" Rows="图框	A3|标注	箭头|说明	单行" Height="100"/>
    <XGridLayout x:Name="Grid1" Columns="名称:120|数值:80" Rows="甲	12|乙	34|丙	56" Height="100"/>

    <XLabel x:Name="Hdr3" Text="虚拟化与磁贴" Height="26" FontSize="14" FontWeight="Bold"/>
    <XVirtualList x:Name="VList" Items="第一行|第二行|第三行|第四行|第五行" ItemHeight="24"
                 SelectedIndex="0" Height="100"/>
    <XGridView x:Name="Tiles" Items="回路 1|回路 2|回路 3|回路 4|回路 5|回路 6"
              CellWidth="88" CellHeight="56" SelectedIndex="0" Height="120"/>
    <XPathView x:Name="Cover" Items="方案 A|方案 B|方案 C" SelectedIndex="1" Height="110"/>

    <XLabel x:Name="Hdr4" Text="分页容器" Height="26" FontSize="14" FontWeight="Bold"/>
    <XTabBar x:Name="Tabs" Pages="常规|高级|关于" Height="110"/>
    <XStackView x:Name="Stack" SelectedIndex="0" PageCount="3" Height="90"/>
    <XSwipeView x:Name="Swipe" SelectedIndex="1" PageCount="2" Height="90"/>
    <XPage x:Name="Wizard" SelectedIndex="0" PageCount="2" Height="70"/>
    <XScrollBar x:Name="VBar" Minimum="0" Maximum="100" Value="30" PageSize="10"
               Orientation="Vertical" Height="40"/>

  </XStackPanel>
</XWindow>
