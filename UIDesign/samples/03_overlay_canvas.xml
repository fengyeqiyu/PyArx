<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 03：浮层、画布与日期

  菜单条与上下文菜单同属 Menu 体系；Popup 与 Dialog/Drawer 同实现。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="03 浮层与画布" Width="760" Height="680" Background="#F4F6F8">

  <XStackPanel Margin="16" Spacing="10">

    <XMenuBar x:Name="Top" Items="文件|编辑|视图|帮助" SelectedIndex="0" Height="28"/>
    <XToolBar x:Name="Bar1" Items="新建|打开|保存|运行" SelectedIndex="2" Height="32"
               SelectionChanged="on_tool"/>
    <XMenu x:Name="Ctx" Items="复制|粘贴|删除" Height="56"/>

    <XLabel x:Name="Hdr1" Text="绘图画布" Height="26" FontSize="14" FontWeight="Bold"/>
    <XDwgCanvas x:Name="Plan" Data="{}" Height="260" Click="on_plan_click"/>
    <XQCanvas x:Name="Draw" Height="140"/>

    <XLabel x:Name="Hdr2" Text="日期与浮层" Height="26" FontSize="14" FontWeight="Bold"/>
    <XDatePicker x:Name="Day" Value="2026-11-13" Height="30" ValueChanged="on_day"/>
    <XMonthGrid x:Name="Cal" Value="2026-11-13" Height="170"/>
    <XPopup x:Name="Sheet" Title="确认" Content="保存后关闭？" Height="90"/>

    <XLabel x:Name="Hdr3" Text="滚动与拖拽容器" Height="26" FontSize="14" FontWeight="Bold"/>
    <XPane x:Name="Host" Height="60"/>
    <XSplitView x:Name="Split" Height="16"/>
    <XScrollView x:Name="Scroll" ScrollMin="0" ScrollMax="400" Height="80"/>
    <XFlickable x:Name="Flick" OffsetX="0" OffsetY="0" Height="100"/>
    <XDivider x:Name="Sep" Height="8"/>

  </XStackPanel>
</XWindow>
