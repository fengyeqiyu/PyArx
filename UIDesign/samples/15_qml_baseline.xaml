<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 15：文字基线对齐（对齐 QML 的 anchors.baseline / Qt.AlignBaseline）

  三种写法：
    1) Layout.alignment="Qt.AlignBaseline"  —— 同一行里不同字号，文字基线齐平
    2) anchors.baseline="T2"                —— 本控件基线压到兄弟控件的基线
    3) anchors.top="T3.baseline"            —— 本控件顶边落在兄弟控件的基线上
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="15 基线对齐" Width="440" Height="260" Background="#F4F6F8">

  <XPane x:Name="Root" Padding="12" Spacing="16">

    <!-- 1) 行内基线对齐：16pt 与 9pt 并排，文字底部落在同一条线 -->
    <XStackPanel x:Name="Row1" Orientation="Horizontal" Spacing="8" Height="40">
      <XLabel x:Name="Big1" text="回路一" FontSize="16" width="90"
              Layout.alignment="Qt.AlignBaseline"/>
      <XLabel x:Name="Small1" text="（说明文字 9pt）" FontSize="9" width="150"
              Layout.alignment="Qt.AlignBaseline"/>
    </XStackPanel>

    <!-- 2) anchors.baseline：小字号的说明贴住大字号的基线 -->
    <XStackPanel x:Name="Row2" Orientation="Horizontal" Spacing="8" Height="40">
      <XLabel x:Name="T2" text="标题" FontSize="16" width="90" height="28"/>
      <XLabel x:Name="S2" text="说明" FontSize="9" width="100" height="28"
              anchors.left="T2.right" anchors.baseline="T2"/>
    </XStackPanel>

    <!-- 3) anchors.top = 兄弟.baseline：方块顶边落在标题文字基线上 -->
    <XStackPanel x:Name="Row3" Orientation="Horizontal" Spacing="8" Height="40">
      <XLabel x:Name="T3" text="标题" FontSize="16" width="90" height="28"/>
      <XPane x:Name="P3" width="60" height="18"
             anchors.left="T3.right" anchors.top="T3.baseline"/>
    </XStackPanel>

  </XPane>
</XWindow>
