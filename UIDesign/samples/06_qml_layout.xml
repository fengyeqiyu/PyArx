<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 06：CSS Grid 写法（HTML 口径）

  HTML 里最省事的网格：
      .root { display:grid;
              grid-template-rows: 32px 1fr 32px;
              grid-template-columns: 1fr 1fr; }
      .title { grid-column: 1 / span 2 }
  对应 XML 侧同名字段（大小写不敏感）：
      style="display:grid;grid-template-columns:1fr 1fr;grid-template-rows:32px 1fr 32px"
      style="grid-column:1 / span 2;grid-row:1"
  没写 grid-column / grid-row 的子项按 HTML 的 grid-auto-flow:row 顺次落格；
  子项默认拉伸到单元格（autoTextW 的伪宽度不再算作者宽度）。
  （XAML 的 <XGrid> + Grid.Row/Grid.Column 写法仍然有效。）
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="06 CSS Grid" Width="560" Height="360" Background="#F4F6F8">

  <div x:Name="Root"
       style="display:grid;grid-template-rows:32px 1fr 32px;grid-template-columns:1fr 1fr;margin:16;padding:8;gap:8;height:328">

    <label x:Name="Title" text="CSS Grid 写法" style="grid-row:1;grid-column:1 / span 2;font-size:14;color:#1F2937"/>

    <input x:Name="Left" type="text" value="左边格子（原生 input）" style="grid-row:2;grid-column:1;margin:6"/>

    <XListBox x:Name="Right" style="grid-row:2;grid-column:2;margin:6"/>

    <button x:Name="Bar" text="确定（跨两列的原生 button）" style="grid-row:3;grid-column:1 / span 2;margin:6"/>

  </div>
</XWindow>