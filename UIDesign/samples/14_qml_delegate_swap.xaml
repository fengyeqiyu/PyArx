<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 14：运行时换 delegate 模板（QML 里就是换 delegate 那个 Component）

  QML 里：
      ListView {
          model: [...]
          delegate: rowCompact     // 两个 Component 换着用
      }

  这里：行模板写在 <ControlTemplate x:Key="..."> 里，
       ItemView 用 Delegate="RowWide" 指定用哪一个；
       Python 端 win.setXamlValue("LV", "delegate", "RowCompact") 换过去，
       行控件按新模板全部重建。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="14 运行时换 delegate 模板" Width="520" Height="360" Background="#F4F6F8">

  <XWindow.Resources>
    <XControlTemplate x:Key="RowWide">
      <XStackPanel Orientation="Horizontal" Padding="8" Spacing="8">
        <XLabel x:Name="W{index}" text="{modelData}" width="200"/>
        <XLabel x:Name="S{index}" text="第 {index} 行 · {1}" width="200"/>
        <XLabel x:Name="A{index}" text="{2}" width="90"/>
      </XStackPanel>
    </XControlTemplate>

    <XControlTemplate x:Key="RowCompact">
      <XStackPanel Orientation="Horizontal" Padding="2" Spacing="2">
        <XLabel x:Name="K{index}" text="{index}." width="36"/>
        <XLabel x:Name="N{index}" text="{0}" width="150"/>
        <XButton x:Name="B{index}" text="{2}" width="70" height="24"/>
      </XStackPanel>
    </XControlTemplate>
  </XWindow.Resources>

  <XPane x:Name="Host" Padding="8">
    <XItemView x:Name="LV"
               Delegate="RowWide"
               Model="AT1-1|回路一|正常;AT1-2|回路二|告警"
               ItemHeight="52"
               Layout.fillWidth="true" Layout.fillHeight="true"/>
  </XPane>
</XWindow>
