<?xml version="1.0" encoding="utf-8"?>
<!--
  示例 13：ItemView 的 model 用 Python list 驱动（行模板见示例 11）

  QML 里：
      ListView {
          model: [["AT1-1", "回路一", "正常"], ["AT1-2", "回路二", "告警"]]
          delegate: Item { ... }
      }

  这里 XML 只放一份静态数据让设计器能预览；
  运行时 Python 端用 win.setXmlValue("LV", "model", [[...], [...]]) 换掉整张表，
  行控件按新行数自动销毁重建（与 QML 改 model 的观感一致）。
-->
<XWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xml"
        Title="13 model 接 Python list" Width="520" Height="360" Background="#F4F6F8">
  <XPane x:Name="Host" Padding="8">
    <XItemView x:Name="LV"
               Model="AT1-1|回路一|正常;AT1-2|回路二|告警"
               ItemHeight="52"
               Layout.fillWidth="true" Layout.fillHeight="true">

      <XStackPanel Orientation="Horizontal" Padding="8" Spacing="8">
        <XLabel x:Name="Txt{index}" text="{modelData}" width="140"/>
        <XLabel x:Name="Sub{index}" text="第 {index} 行 · {1}" width="180"/>
        <XLabel x:Name="Act{index}" text="{2}" width="90"/>
      </XStackPanel>

    </XItemView>
  </XPane>
</XWindow>
