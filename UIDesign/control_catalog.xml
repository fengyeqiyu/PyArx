<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!--
  PyArx 控件目录（参照 wxFormBuilder objectinfo 声明机制）
  每个 <objectinfo> 声明一个可在设计器画布上放置的控件：
    tag       = XAML 标签（XamlRuntime 实例化用）
    display   = 控件箱显示名
    category  = 控件箱分类
    w / h     = 拖入画布时的默认尺寸
  子 <property name type> 声明该控件的属性表（属性面板按此表展示/编辑）。
  新增自定义控件：在此文件加一个 <objectinfo> + 在 C++ 注册实例化即可，无需改硬编码分支。
-->
<package name="PyArx" desc="PyArx XAML 控件目录">

  <objectinfo tag="Button" display="Button" category="Buttons" w="100" h="28">
    <property name="Name" type="text"/>
    <property name="Text" type="text"/>
    <property name="Icon" type="text"/>
    <property name="Shape" type="enum" options="Rect|RoundRect|Ellipse|Capsule"/>
    <property name="Background" type="color"/>
    <property name="FrontColor" type="color"/>
    <property name="Foreground" type="color"/>
    <property name="BorderColor" type="color"/>
    <property name="BorderStyle" type="enum" options="None|Single|Sunken|Raised"/>
    <property name="BorderThickness" type="int"/>
    <property name="Radius" type="int"/>
    <property name="Opacity" type="int"/>
    <property name="FontSize" type="int"/>
    <property name="FontFamily" type="text"/>
    <property name="TextAlign" type="enum" options="Left|Center|Right"/>
    <property name="Style" type="text"/>
    <property name="Template" type="text"/>
    <property name="Enabled" type="bool"/>
    <property name="Visible" type="bool"/>
    <property name="Click" type="text"/>
    <property name="Dock" type="enum" options="None|Fill|Top|Bottom|Left|Right"/>
    <property name="Orientation" type="enum" options="Horizontal|Vertical"/>
    <property name="ScrollStyle" type="enum" options="None|Vertical|Horizontal|Both"/>
  </objectinfo>

